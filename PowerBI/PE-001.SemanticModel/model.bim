      {
        "name": "MeasuresBI",
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "5a10e36c201a48139564d874306a1d17"
          }
        ],
        "columns": [
          {
            "name": "Value",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "formatString": "0",
            "isDataTypeInferred": true,
            "isNameInferred": true,
            "lineageTag": "f2244761-ce72-45ab-ad14-750794ca6e66",
            "sourceColumn": "[Value]",
            "summarizeBy": "sum",
            "type": "calculatedTableColumn"
          }
        ],
        "lineageTag": "86b444c4-d1d0-4b67-8621-d668863ed3a6",
        "measures": [
          {
            "name": "Total Sales",
            "displayFolder": "Sales",
            "expression": [
              "",
              "SUM ( FactSales[LineTotal] )"
            ],
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "f0319e29-2b1d-4cea-afce-c4be22b931ac"
          },
          {
            "name": "Total Orders",
            "displayFolder": "Sales",
            "expression": [
              "",
              "DISTINCTCOUNT ( FactSales[SalesOrderID] )"
            ],
            "formatString": "0",
            "lineageTag": "92d6082c-349e-4f2e-a96e-e4de24ef99ae"
          },
          {
            "name": "Total Quantity Sold",
            "displayFolder": "Sales",
            "expression": [
              "",
              "SUM ( FactSales[OrderQty] )"
            ],
            "formatString": "0",
            "lineageTag": "35fa5d1e-ad8e-4ed4-ab24-ad10a25cf7d1"
          },
          {
            "name": "Average Order Value",
            "displayFolder": "Sales",
            "expression": [
              "",
              "DIVIDE (",
              "    [Total Sales],",
              "    [Total Orders]",
              ")"
            ],
            "formatString": "\\$#,0.###############;(\\$#,0.###############);\\$#,0.###############",
            "lineageTag": "43c12cb0-66ed-41da-88c5-b37eef862a37"
          },
          {
            "name": "Average Selling Price",
            "displayFolder": "Sales",
            "expression": [
              "",
              "DIVIDE (",
              "    [Total Sales],",
              "    [Total Quantity Sold]",
              ")"
            ],
            "formatString": "\\$#,0.###############;(\\$#,0.###############);\\$#,0.###############",
            "lineageTag": "2cd66f09-7cd6-4f35-b575-cbfa1581455c"
          },
          {
            "name": "Average Quantity per Order",
            "displayFolder": "Sales",
            "expression": [
              "",
              "DIVIDE (",
              "    [Total Quantity Sold],",
              "    [Total Orders]",
              ")"
            ],
            "formatString": "0.00",
            "lineageTag": "4def6181-1099-476b-adac-eaff41247111"
          },
          {
            "name": "Sales YTD",
            "displayFolder": "Time Intelligence",
            "expression": [
              "",
              "TOTALYTD (",
              "    [Total Sales],",
              "    DimDate[Date]",
              ")"
            ],
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "0e383fdf-e92c-46ca-b3a4-27b8410a790b"
          },
          {
            "name": "Sales MTD",
            "displayFolder": "Time Intelligence",
            "expression": [
              "",
              "TOTALMTD (",
              "    [Total Sales],",
              "    DimDate[Date]",
              ")"
            ],
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "659299cf-5b0c-4fb5-9164-7a498878f703"
          },
          {
            "name": "Sales QTD",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ],
            "displayFolder": "Time Intelligence",
            "expression": [
              "",
              "TOTALQTD (",
              "    [Total Sales],",
              "    DimDate[Date]",
              ")"
            ],
            "formatString": "\\$#,0.0;(\\$#,0.0);\\$#,0.0",
            "lineageTag": "6cdd5388-9656-4a1c-80a4-42fb2cd1e2ca"
          },
          {
            "name": "Sales Last Year",
            "displayFolder": "Time Intelligence",
            "expression": [
              "",
              "CALCULATE (",
              "    [Total Sales],",
              "    SAMEPERIODLASTYEAR ( DimDate[Date] )",
              ")"
            ],
            "formatString": "\\$#,0.###############;(\\$#,0.###############);\\$#,0.###############",
            "lineageTag": "180a06f9-f707-4719-a24d-dbaf3b276c02"
          },
          {
            "name": "YoY Growth %",
            "displayFolder": "Time Intelligence",
            "expression": [
              "",
              "DIVIDE (",
              "    [Total Sales] - [Sales Last Year],",
              "    [Sales Last Year]",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "80cb4257-2b14-4813-8e8c-f223dc8549af"
          },
          {
            "name": "Rolling 12 Months Sales",
            "displayFolder": "Time Intelligence",
            "expression": [
              "",
              "CALCULATE (",
              "    [Total Sales],",
              "    DATESINPERIOD (",
              "        DimDate[Date],",
              "        MAX ( DimDate[Date] ),",
              "        -12,",
              "        MONTH",
              "    )",
              ")"
            ],
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "8371bab8-bf73-4c51-a8df-98496061c099"
          },
          {
            "name": "Latest Sales Date",
            "displayFolder": "Time Intelligence",
            "expression": [
              "",
              "MAX ( FactSales[OrderDate] )"
            ],
            "formatString": "Short Date",
            "lineageTag": "fb309d5d-da5b-4e84-8011-ccf7ed1aef1d"
          },
          {
            "name": "Executive YoY Growth YTD %",
            "displayFolder": "Time Intelligence",
            "expression": [
              "",
              "VAR LatestDate =",
              "    CALCULATE (",
              "        MAX ( FactSales[OrderDate] ),",
              "        ALL ( FactSales )",
              "    )",
              "",
              "VAR CurrentYTD =",
              "    CALCULATE (",
              "        [Total Sales],",
              "        DATESBETWEEN (",
              "            DimDate[Date],",
              "            DATE ( YEAR ( LatestDate ), 1, 1 ),",
              "            LatestDate",
              "        )",
              "    )",
              "",
              "VAR PreviousYTD =",
              "    CALCULATE (",
              "        [Total Sales],",
              "        DATESBETWEEN (",
              "            DimDate[Date],",
              "            DATE ( YEAR ( LatestDate ) - 1, 1, 1 ),",
              "            EDATE ( LatestDate, -12 )",
              "        )",
              "    )",
              "",
              "RETURN",
              "DIVIDE ( CurrentYTD - PreviousYTD, PreviousYTD )"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "f8284bab-3557-4748-b467-c0a3583a8d77"
          }
        ],
        "partitions": [
          {
            "name": "MeasuresBI",
            "mode": "import",
            "source": {
              "expression": "{ BLANK() }",
              "type": "calculated"
            }
          }
        ]
      }
    ]
